{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": ["**/*.md", "**/*.mdx"],
  "sortImports": {
    "newlinesBetween": false,
    "customGroups": [
      {
        "groupName": "sentry",
        "elementNamePattern": ["@sentry/**"]
      }
    ],
    "groups": [
      "sentry",
      ["builtin", "external"],
      "internal",
      ["parent", "sibling", "index"],
      "unknown"
    ]
  }
}
